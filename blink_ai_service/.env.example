# انسخ الملف ده باسم .env وحط المفتاح بس لو عايز تشغل Cloud LLM API.
# لو سبت المفتاح فاضي، موديول الـ LLM هيشتغل أوتوماتيك بالمحرك المحلي (Offline AAC Fallback).

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# إعدادات الصوت (TTS):
# 1) صوت واقعي جداً عبر ElevenLabs (مجاني لحد ~20,000 حرف/شهر، وكل جملة بتتحفظ أوفلاين للأبد):
#    ملحوظة: الأصوات الافتراضية المضمونة على الباقة المجانية هي Adam (عربي) و George (إنجليزي).
#    لو معاك باقة مدفوعة تقدر تغيّر ELEVENLABS_VOICE_ID_AR لصوت مكتبة زي Haytham (IES4nrmZdUBHByLBde0P).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID_AR=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_EN=JBFqnCBsd6RMkjVDRZzb

# 2) وضع التشغيل:
# auto    = أونلاين (ElevenLabs لو فيه مفتاح، وإلا Edge شاكر المصري) + كاش وحفظ أوفلاين تلقائي
# offline = أوفلاين 100% فقط بدون نت (يشغل كاش ElevenLabs/Edge المحفوظ أولاً ثم ويندوز/Piper)
# online  = نت فقط
TTS_MODE=auto

# إعدادات السيرفر والأمان
ALLOWED_ORIGINS=*
PORT=8000
